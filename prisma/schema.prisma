generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}

enum ProcessStep {
  CREATED
  CAPACITY_RESERVED
  PAYMENT_APPROVED
  TICKETS_ISSUED
  COMPLETED
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  sectorId       String       @map("sector_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal?     @map("unit_price") @db.Decimal(12, 2)
  totalAmount    Decimal?     @map("total_amount") @db.Decimal(12, 2)
  currency       String       @default("BOB") @db.Char(3)
  status         OrderStatus  @default(PENDING)
  processStep    ProcessStep  @default(CREATED) @map("process_step")
  releasePending Boolean      @default(false) @map("release_pending")
  failureCode    String?      @map("failure_code") @db.VarChar(80)
  lastError      String?      @map("last_error") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([eventId, status])
  @@index([status, processStep])
  @@map("orders")
}
